---
// "Pide aquí": el WhatsApp es el canal principal (sin comisión para el
// local) y las apps van como respaldo. Una sola sucursal, sin selector.
//
// Nota: se usan los nombres de las apps con su color de marca como punto,
// no sus logotipos oficiales (marca registrada). Si el dueño quiere los
// logos reales, se agregan como assets después.
import { negocio } from "../../data/negocio.js";

const whatsapp = `https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent(negocio.mensajeWhatsapp)}`;

const apps = [
  { nombre: "Uber Eats", href: negocio.canales.ubereats, color: "#06C167" },
  { nombre: "Rappi", href: negocio.canales.rappi, color: "#FF441F" },
  { nombre: "PedidosYa", href: negocio.canales.pedidosya, color: "#FA0050" },
].filter((a) => a.href);
---

<section id="pedidos" class="mx-auto max-w-5xl px-5 py-20">
  <header class="revelar mb-10 text-center">
    <p class="text-sm uppercase tracking-[0.3em] text-texto-suave">
      Pide aquí
    </p>
    <h2 class="neon titulo-toros mt-2 text-4xl sm:text-5xl">
      Directo a la parrilla
    </h2>
    <p class="mx-auto mt-4 max-w-md text-texto-suave">
      Escríbenos por WhatsApp y te tomamos el pedido al tiro. Así pagas el
      precio de la carta, sin comisión. O pídelo por tu app favorita.
    </p>
  </header>

  <a
    href={whatsapp}
    target="_blank"
    rel="noopener"
    class="revelar mx-auto flex max-w-md items-center justify-center gap-3 rounded-suave bg-marca px-8 py-5 text-lg font-semibold text-white shadow-lg shadow-marca/25 transition hover:bg-marca-hover active:translate-y-px active:scale-[0.98]"
  >
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path
        d="M12.05 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.6 5.95L0 24l6.35-1.7a11.9 11.9 0 005.69 1.45h.01c6.55 0 11.89-5.33 11.89-11.89C23.94 5.33 18.6 0 12.05 0zm0 21.79h-.01a9.86 9.86 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.38a9.84 9.84 0 01-1.51-5.26c0-5.44 4.43-9.87 9.88-9.87 2.64 0 5.12 1.03 6.98 2.9a9.82 9.82 0 012.89 6.98c0 5.45-4.43 9.88-9.87 9.88zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
      ></path>
    </svg>
    Pedir por WhatsApp
  </a>

  <div class="revelar mt-8">
    <p class="mb-4 text-center text-xs uppercase tracking-widest text-texto-suave">
      O en delivery
    </p>
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        apps.map((app) => (
          <li>
            <a
              href={app.href}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2.5 rounded-suave border border-borde bg-superficie px-5 py-4 font-semibold transition duration-300 hover:-translate-y-0.5 hover:border-texto-suave hover:bg-superficie-alta hover:shadow-lg hover:shadow-black/30"
            >
              <span
                class="h-2.5 w-2.5 shrink-0 rounded-full"
                style={`background:${app.color}`}
                aria-hidden="true"
              />
              {app.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
