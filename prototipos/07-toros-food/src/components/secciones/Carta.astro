---
// La carta completa: todas las categorías en orden, sin fotos (con esta
// cantidad de platos las miniaturas estorban más de lo que aportan).
// La personalidad la ponen la tipografía condensada, el acento rojo-naranja
// y el tratamiento neón en los nombres de categoría (el letrero del local).
//
// Una sola cocina, así que no hay filtro por grupo: se muestran todas.
import PlatoItem from "../PlatoItem.astro";
import { categorias } from "../../data/carta.js";
---

<!-- Índice pegajoso: poder saltar a una categoría importa más que cualquier
     adorno. Es <nav> con anclas, cero JavaScript. -->
<nav
  aria-label="Categorías"
  class="sticky top-[3.75rem] z-10 border-b border-borde bg-fondo/95 backdrop-blur"
>
  <ul class="fila-deslizante mx-auto flex max-w-5xl gap-2.5 px-5 py-3.5">
    {
      categorias.map((categoria) => (
        <li>
          <a
            href={`#cat-${categoria.id}`}
            class="letrero-pill titulo-toros block whitespace-nowrap rounded-full border border-borde px-3.5 py-1.5 text-sm text-texto-suave transition"
          >
            {categoria.nombre}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<div class="mx-auto max-w-3xl space-y-16 px-5 py-16 sm:space-y-20 sm:py-20">
  {
    categorias.map((categoria) => (
      <section aria-labelledby={`cat-${categoria.id}`} class="scroll-ancla">
        <header class="mb-6">
          <h2
            id={`cat-${categoria.id}`}
            class="neon titulo-toros text-4xl sm:text-5xl"
          >
            {categoria.nombre}
          </h2>
          <div class="mt-3 h-px w-14 bg-marca" />
          {categoria.nota && (
            <p class="mt-3 text-sm text-texto-suave">{categoria.nota}</p>
          )}
        </header>

        <ul>
          {categoria.platos.map((plato) => (
            <PlatoItem {...plato} />
          ))}
        </ul>
      </section>
    ))
  }
</div>
