---
// Logo de la marca: el toro oficial (vectorizado, nítido) + el wordmark
// "TOROS FOOD". El logo oficial apila el toro sobre "TOROS"; en la barra
// horizontal se arma con el toro al lado del nombre para que quede compacto.
import Toro from "./Toro.astro";

interface Props {
  tamano?: number;
  conTexto?: boolean;
  class?: string;
}

const { tamano = 40, conTexto = true, class: clase = "" } = Astro.props;
const alto = Math.round(tamano * 0.72);
---

<span class={`flex items-center gap-2.5 ${clase}`}>
  <Toro class="shrink-0 text-marca" style={`height:${alto}px;width:auto`} />
  {
    conTexto && (
      <span class="titulo-toros text-xl leading-none tracking-tight">
        TOROS<span class="text-marca-texto"> FOOD</span>
      </span>
    )
  }
</span>
