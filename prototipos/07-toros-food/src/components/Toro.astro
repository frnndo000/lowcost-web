---
// Motivo del toro — la silueta oficial de la marca, VECTORIZADA del logo
// (public/toro.svg) para que se vea nítida a cualquier tamaño. Se pinta con
// una máscara CSS: el color viene de `currentColor` (una clase text-*), el
// tamaño de width/height y la opacidad de la clase que lo usa.
//
// Firma gráfica recurrente: marca de agua en la carta, los combos y el footer,
// y el logo del header.
interface Props {
  class?: string;
  style?: string;
}
const { class: clase = "", style } = Astro.props;
---

<span class={`toro-mask ${clase}`} style={style} aria-hidden="true"></span>
