---
// Una línea de la carta. El precio se formatea con clp(), el único
// formateador del proyecto: no se repite un Intl.NumberFormat suelto
// en las páginas.
import { clp } from "../data/carta.js";

interface Props {
  nombre: string;
  precio: number;
  descripcion?: string;
  veggie?: boolean;
}

const { nombre, precio, descripcion, veggie } = Astro.props;
---

<li class="flex items-baseline gap-4 border-b border-borde/60 py-3">
  <div class="min-w-0">
    <span class="text-texto">
      {nombre}
      {
        veggie && (
          <span class="ml-2 align-middle text-[0.65rem] uppercase tracking-widest text-texto-suave">
            Vegetariano
          </span>
        )
      }
    </span>
    {
      descripcion && (
        <p class="mt-0.5 text-sm leading-snug text-texto-suave">{descripcion}</p>
      )
    }
  </div>
  <span class="ml-auto shrink-0 titulo-toros text-lg tabular-nums text-precio">
    {clp(precio)}
  </span>
</li>
